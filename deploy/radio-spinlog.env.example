# Environment of the radio-spinlog service: /etc/radio-spinlog.env, mode 600 (it holds secrets).
# Every line is optional; without this file the daemon archives all stations into SQLite.

# PostgreSQL instead of the local SQLite file (Supabase: the "Session pooler" URL)
#RADIO_SPINLOG_DB=postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:5432/postgres

# Where to push alerts (stale source, lost tracks)
#RADIO_SPINLOG_WEBHOOK=https://discord.com/api/webhooks/<id>/<token>

# Pinged every 5 minutes while the daemon runs
#RADIO_SPINLOG_HEARTBEAT=https://hc-ping.com/<uuid>
